#!/usr/bin/env bash

set -euo pipefail

THEME_DIR="$HOME/.local/state/omarchy/current/theme"
COLORS="$THEME_DIR/colors.toml"

GTK4_DIR="$HOME/.config/gtk-4.0"
GTK4_CSS="$GTK4_DIR/gtk.css"

mkdir -p "$GTK4_DIR"

python - "$COLORS" "$GTK4_CSS" <<'PY'
import sys
import tomllib
from pathlib import Path

colors_file = Path(sys.argv[1])
gtk_css = Path(sys.argv[2])

with colors_file.open("rb") as f:
    c = tomllib.load(f)

def color(name, fallback):
    value = c.get(name, fallback)
    if not isinstance(value, str):
        return fallback
    return value

background = color("background", "#1e1e1e")
foreground = color("foreground", "#ffffff")
accent = color("accent", foreground)
selection = color("selection", accent)
muted = color("muted", foreground)

# Pick readable text for accent-colored controls.
def rgb(hex_color):
    h = hex_color.lstrip("#")
    if len(h) != 6:
        return (128, 128, 128)
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))

def luminance(hex_color):
    r, g, b = rgb(hex_color)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b

accent_luma = luminance(accent)
bg_luma = luminance(background)
fg_luma = luminance(foreground)

accent_fg = background if abs(accent_luma - bg_luma) > abs(accent_luma - fg_luma) else foreground

css = f"""/* OMARCHY-NAUTILUS-START
 * Automatically generated by 90-nautilus-gtk.
 * Do not edit this block manually.
 */

@define-color omarchy_background {background};
@define-color omarchy_foreground {foreground};
@define-color omarchy_accent {accent};
@define-color omarchy_selection {selection};
@define-color omarchy_muted {muted};
@define-color omarchy_accent_fg {accent_fg};

/* Main Nautilus window */
window,
window.background,
.nautilus-window {{
    background-color: @omarchy_background;
    color: @omarchy_foreground;
}}

/* Main file view */
.view,
.view.background,
.nautilus-window .view,
.nautilus-window scrolledwindow {{
    background-color: @omarchy_background;
    color: @omarchy_foreground;
}}

/* Sidebar */
.sidebar,
.nautilus-window .sidebar {{
    background-color: @omarchy_background;
    color: @omarchy_foreground;
}}

/* Headerbar */
headerbar {{
    background-color: @omarchy_background;
    color: @omarchy_foreground;
}}

/* Nautilus file names */
.nautilus-canvas-item {{
    color: @omarchy_foreground;
}}

/* Selection */
.view:selected,
.view row:selected,
.nautilus-canvas-item:selected {{
    background-color: @omarchy_selection;
    color: @omarchy_foreground;
}}

/* Accent buttons */
button.suggested-action,
button.default {{
    background-color: @omarchy_accent;
    color: @omarchy_accent_fg;
}}

/* Entries */
entry {{
    background-color: @omarchy_background;
    color: @omarchy_foreground;
}}

/* Popovers / menus */
popover,
popover.background {{
    background-color: @omarchy_background;
    color: @omarchy_foreground;
}}

/* Remove accidental transparency */
window,
headerbar,
.sidebar,
.view,
.content-view {{
    background-image: none;
}}

/* OMARCHY-NAUTILUS-END */
"""

old = gtk_css.read_text() if gtk_css.exists() else ""

start = "/* OMARCHY-NAUTILUS-START"
end = "/* OMARCHY-NAUTILUS-END */"

if start in old and end in old:
    before = old.split(start, 1)[0]
    after = old.split(end, 1)[1]
    old = before.rstrip() + "\n" + after.lstrip()

gtk_css.write_text(old.rstrip() + "\n\n" + css)
PY

# Restart Nautilus so libadwaita reloads the CSS.
pkill -x nautilus 2>/dev/null || true
