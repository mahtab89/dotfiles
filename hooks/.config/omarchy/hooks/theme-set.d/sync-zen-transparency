#!/bin/bash

ZEN_DIR="$HOME/.config/zen"
PROFILES_INI="$ZEN_DIR/profiles.ini"

# Don't touch prefs.js while Zen is running.
if pgrep -x zen-bin >/dev/null; then
    exit 0
fi

# Find the profile used by the current Zen installation.
PROFILE_PATH=$(awk -F= '
    /^\[Install/ { in_install=1; next }
    in_install && /^Default=/ {
        print $2
        exit
    }
' "$PROFILES_INI")

[[ -n "$PROFILE_PATH" ]] || exit 0

# Handle relative profile paths.
if [[ "$PROFILE_PATH" != /* ]]; then
    PROFILE_PATH="$ZEN_DIR/$PROFILE_PATH"
fi

ZEN_PREFS="$PROFILE_PATH/prefs.js"

[[ -f "$ZEN_PREFS" ]] || exit 0

# Get the active Omarchy background.
BACKGROUND=$(omarchy-theme-color background 2>/dev/null)

[[ "$BACKGROUND" =~ ^#[0-9a-fA-F]{6}$ ]] || exit 0

# Keep 90% opacity (e6).
ZEN_COLOR="${BACKGROUND}e6"

# Update Transparent Zen's preference.
sed -i \
    "s|user_pref(\"mod.sameerasw.zen_transparency_color\", \"[^\"]*\");|user_pref(\"mod.sameerasw.zen_transparency_color\", \"$ZEN_COLOR\");|" \
    "$ZEN_PREFS"
